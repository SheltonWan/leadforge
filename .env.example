# ──────────────────────────────────────────────────────────────────────────────
# LeadForge — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase — create a free project at https://supabase.com/dashboard
# Project Settings → API → URL and anon/public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-side admin operations only (optional in M1)
# SUPABASE_SERVICE_ROLE_KEY=

# App base URL (used for absolute redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Optional — AI scoring provider (Milestone 1 uses heuristic/mock by default)
# ──────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
